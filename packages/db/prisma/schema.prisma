// مخطط قاعدة البيانات. كل تغيير = ترحيل جديد في prisma/migrations (لا تعديل لترحيل مطبَّق).
// الأسماء في القاعدة snake_case، وفي الكود camelCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// النادي. المنصة اليوم لنادٍ واحد، لكن الجداول الرئيسية تحمل club_id من البداية
/// ليبقى طريق الترخيص التجاري مفتوحًا بلا إعادة بناء (انظر docs/DECISIONS.md).
model Club {
  id                        String               @id @default(uuid(7)) @db.Uuid
  slug                      String               @unique
  nameAr                    String               @map("name_ar")
  nameEn                    String               @map("name_en")
  timezone                  String               @default("Asia/Riyadh")
  currency                  String               @default("SAR") @db.Char(3)
  /// نسبة ضريبة القيمة المضافة بنقاط الأساس (1500 = 15%). بلا افتراضي: القيمة من الترحيل أو من المالك.
  vatRateBps                Int                  @map("vat_rate_bps")
  /// مهلة الطلب غير المدفوع بالدقائق. NULL = غير محسوم، فلا يُنشأ أي طلب.
  orderPaymentWindowMinutes Int?                 @map("order_payment_window_minutes")
  /// متى يبدأ الاشتراك. NULL = غير محسوم، فلا يُنشأ أي طلب اشتراك.
  membershipStartRule       MembershipStartRule? @map("membership_start_rule")
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  products             Product[]
  customers            Customer[]
  promotions           Promotion[]
  orders               Order[]
  memberships          Membership[]
  refunds              Refund[]
  assessmentRequests   AssessmentRequest[]
  auditLogs            AuditLog[]
  paymentAttempts      PaymentAttempt[]
  paymentIncidents     PaymentIncident[]
  staffUsers           StaffUser[]
  manualPayments       ManualPayment[]
  contentReleases      ContentRelease[]
  contentDrafts        ContentDraftEntry[]
  mediaAssets          MediaAsset[]
  contentSlides        ContentSlide[]
  sliderSettings       ContentSliderSettings?
  trackingIntegrations TrackingIntegration[]
  orderTracking        OrderTracking[]
  trackingOutbox       TrackingOutbox[]

  @@map("clubs")
}

/// نوع المنتج يحدد مسار البيع: الاشتراك والبرنامج الرقمي يُشتريان مباشرة،
/// والخدمة بتقييم (تدريب شخصي، تأهيل) تبدأ بحجز تقييم لا بدفع.
enum ProductKind {
  membership
  digital_program
  assessed_service
  /// إضافة تُباع مع باقة مرتبطة بها في product_addons (المرحلة 3)
  addon

  @@map("product_kind")
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

/// هوية المنتج الثابتة (الاسم والرابط). السعر والمدة في ProductVersion.
model Product {
  id        String        @id @default(uuid(7)) @db.Uuid
  clubId    String        @map("club_id") @db.Uuid
  kind      ProductKind
  slug      String        @unique
  nameAr    String        @map("name_ar")
  nameEn    String        @map("name_en")
  summaryAr String        @map("summary_ar")
  summaryEn String        @map("summary_en")
  /// اسم الفئة التسويقي للاشتراك («رحلة الأبطال»): باللغتين معًا أو لا شيء (CHECK في ترحيل catalog_admin)
  tierAr    String?       @map("tier_ar")
  tierEn    String?       @map("tier_en")
  sortOrder Int           @default(0) @map("sort_order")
  status    ProductStatus @default(draft)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  versions ProductVersion[]

  addonsOffered      ProductAddon[]      @relation("ProductAddonMembership")
  offeredWith        ProductAddon[]      @relation("ProductAddonAddon")
  promotionProducts  PromotionProduct[]
  orderItems         OrderItem[]         @relation("OrderItemProductKind")
  assessmentRequests AssessmentRequest[]

  /// هدف المفاتيح المركّبة التي تشترط نوع المنتج (FK3، FK7)
  @@unique([id, kind])
  @@index([clubId, kind, status, sortOrder])
  @@map("products")
}

/// نسخة تسعير: السعر والمدة والمزايا كما تُباع في فترة سريانها.
/// تغيير السعر = نسخة جديدة؛ أعمدة التسعير لا تُعدَّل أبدًا، ومزايا النسخة المباعة ثابتة (triggers المرحلة 3).
model ProductVersion {
  id             String    @id @default(uuid(7)) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  /// بالهللة، شامل الضريبة
  priceMinor     Int       @map("price_minor")
  currency       String    @default("SAR") @db.Char(3)
  /// مدة الاشتراك المدفوعة بالأشهر (فارغ لما ليس له مدة)
  durationMonths Int?      @map("duration_months")
  /// أشهر مجانية فوق المدة المدفوعة
  bonusMonths    Int       @default(0) @map("bonus_months")
  validFrom      DateTime  @map("valid_from") @db.Timestamptz(3)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  benefits ProductBenefit[]

  orderItemsByPrice    OrderItem[] @relation("OrderItemVersionPrice")
  orderItemsByDuration OrderItem[] @relation("OrderItemVersionDuration")

  /// أهداف المفاتيح المركّبة: سطر الطلب لا يخالف سعر نسخته ولا مدتها (FK1، FK2)
  @@unique([id, productId, priceMinor, currency, bonusMonths])
  @@unique([id, durationMonths])
  @@index([productId, validFrom])
  @@map("product_versions")
}

model ProductBenefit {
  id        String @id @default(uuid(7)) @db.Uuid
  versionId String @map("version_id") @db.Uuid
  labelAr   String @map("label_ar")
  labelEn   String @map("label_en")
  sortOrder Int    @default(0) @map("sort_order")

  version ProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, sortOrder])
  @@map("product_benefits")
}

// ───────────── المرحلة 3: البيع (docs/PHASE3_COMMERCE_DESIGN.md) ─────────────
// المال INTEGER بالهللة. كل مفتاح أجنبي جديد RESTRICT للحذف والتحديث.
// CHECK والتسلسل والـtriggers في ترحيل 20261125090100_commerce لأن Prisma لا يعبّر عنها.

/// متى يبدأ الاشتراك: من تاريخ الدفع أم من أول زيارة (قرار المالك).
enum MembershipStartRule {
  on_payment
  on_first_visit

  @@map("membership_start_rule")
}

enum PromotionStatus {
  draft
  active
  /// أوقفه الموظف مؤقتًا من اللوحة (A2): يُفعَّل من جديد، ولا يدخل التسعير
  paused
  archived

  @@map("promotion_status")
}

enum DiscountKind {
  percentage
  fixed_amount

  @@map("discount_kind")
}

enum PromotionAudience {
  anyone
  new_customer
  existing_customer

  @@map("promotion_audience")
}

enum PromotionScope {
  all_products
  listed_products

  @@map("promotion_scope")
}

enum DiscountSource {
  automatic
  coupon

  @@map("discount_source")
}

enum OrderStatus {
  pending_payment
  paid
  fulfilled
  expired
  cancelled
  partially_refunded
  refunded

  @@map("order_status")
}

enum MembershipStatus {
  scheduled
  active
  frozen
  expired
  cancelled

  @@map("membership_status")
}

enum RefundStatus {
  requested
  approved
  rejected
  processing
  completed
  failed

  @@map("refund_status")
}

/// أي إضافة تُعرض مع أي باقة. بلا صف ربط لا تُعرض الإضافة ولا تُقبل في السلة.
/// عمودا النوع ثابتان بـCHECK، والمفتاحان المركّبان يمنعان ربط منتج من نوع خاطئ.
model ProductAddon {
  membershipProductId String      @map("membership_product_id") @db.Uuid
  membershipKind      ProductKind @default(membership) @map("membership_kind")
  addonProductId      String      @map("addon_product_id") @db.Uuid
  addonKind           ProductKind @default(addon) @map("addon_kind")
  sortOrder           Int         @default(0) @map("sort_order")

  membership Product @relation("ProductAddonMembership", fields: [membershipProductId, membershipKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  addon      Product @relation("ProductAddonAddon", fields: [addonProductId, addonKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)

  @@id([membershipProductId, addonProductId])
  @@map("product_addons")
}

/// المشتري بجواله فقط. لا اسم هنا: من يكتب جوال غيره لا يغيّر شيئًا من بياناته.
model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  phoneE164 String   @map("phone_e164")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  club               Club                @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orders             Order[]
  memberships        Membership[]
  assessmentRequests AssessmentRequest[]

  @@unique([clubId, phoneE164])
  @@map("customers")
}

/// العرض التلقائي والكوبون جدول واحد: code فارغ = عرض تلقائي.
model Promotion {
  id                        String            @id @default(uuid(7)) @db.Uuid
  clubId                    String            @map("club_id") @db.Uuid
  code                      String?
  nameAr                    String            @map("name_ar")
  nameEn                    String            @map("name_en")
  status                    PromotionStatus   @default(draft)
  discountKind              DiscountKind      @map("discount_kind")
  percentBps                Int?              @map("percent_bps")
  amountMinor               Int?              @map("amount_minor")
  currency                  String?           @db.Char(3)
  /// بلا افتراضي: الجمهور والنطاق يُختاران صراحةً
  audience                  PromotionAudience
  scope                     PromotionScope
  stackable                 Boolean           @default(false)
  startsAt                  DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt                    DateTime?         @map("ends_at") @db.Timestamptz(3)
  maxRedemptions            Int?              @map("max_redemptions")
  maxRedemptionsPerCustomer Int?              @map("max_redemptions_per_customer")
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// رمز القفل المتفائل لنموذج التعديل في اللوحة (A2)
  updatedAt                 DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  club      Club               @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products  PromotionProduct[]
  discounts OrderDiscount[]

  @@unique([clubId, code])
  @@index([clubId, status, startsAt])
  @@map("promotions")
}

/// منتجات عرض نطاقه listed_products. بلا صفوف لا ينطبق على شيء (الاتجاه الآمن).
model PromotionProduct {
  promotionId String @map("promotion_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

/// الطلب: الرأس ولقطة العميل والتسوية في صف واحد. اللقطة لا تتغير (trigger)،
/// والمتغير فقط الحالة وأعمدة paid_* (مرة واحدة) وأوقات الانتقال.
model Order {
  id                    String      @id @default(uuid(7)) @db.Uuid
  clubId                String      @map("club_id") @db.Uuid
  reference             String      @unique @default(dbgenerated("('MSR-'::text || lpad((nextval('order_reference_seq'::regclass))::text, 7, '0'::text))"))
  /// 32 بايت عشوائي base64url (43 محرفًا)
  publicToken           String      @unique @map("public_token")
  idempotencyKey        String      @unique @map("idempotency_key") @db.Uuid
  requestFingerprint    String      @map("request_fingerprint") @db.Char(64)
  customerId            String      @map("customer_id") @db.Uuid
  customerName          String      @map("customer_name")
  customerPhoneE164     String      @map("customer_phone_e164")
  locale                String      @db.Char(2)
  status                OrderStatus @default(pending_payment)
  currency              String      @db.Char(3)
  vatRateBps            Int         @map("vat_rate_bps")
  subtotalMinor         Int         @map("subtotal_minor")
  discountMinor         Int         @map("discount_minor")
  totalMinor            Int         @map("total_minor")
  vatMinor              Int         @map("vat_minor")
  createdAt             DateTime    @map("created_at") @db.Timestamptz(3)
  expiresAt             DateTime    @map("expires_at") @db.Timestamptz(3)
  paidAt                DateTime?   @map("paid_at") @db.Timestamptz(3)
  paidProvider          String?     @map("paid_provider")
  paidProviderPaymentId String?     @map("paid_provider_payment_id")
  paidAmountMinor       Int?        @map("paid_amount_minor")
  paidCurrency          String?     @map("paid_currency") @db.Char(3)
  fulfilledAt           DateTime?   @map("fulfilled_at") @db.Timestamptz(3)
  expiredAt             DateTime?   @map("expired_at") @db.Timestamptz(3)
  cancelledAt           DateTime?   @map("cancelled_at") @db.Timestamptz(3)

  club             Club                     @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer         Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items            OrderItem[]
  discounts        OrderDiscount[]
  memberships      Membership[]
  refunds          Refund[]
  paymentAttempts  PaymentAttempt[]
  paymentIncidents PaymentIncident[]
  manualPayment    ManualPayment?
  tracking         OrderTracking?
  trackingOutbox   TrackingOutbox[]
  browserPurchase  TrackingBrowserPurchase?

  /// دفعة المزوّد تسوّي طلبًا واحدًا فقط
  @@unique([paidProvider, paidProviderPaymentId])
  /// أهداف مفاتيح مركّبة: الخصم لعميل الطلب نفسه (FK4)، والاشتراك لطلب مدفوع (FK6)
  @@unique([id, customerId])
  @@unique([id, paidAt])
  @@index([status, expiresAt])
  @@index([customerId, createdAt])
  /// قائمة الطلبات في اللوحة: الأحدث أولًا لكل نادٍ، ومدى زمني على الإنشاء
  @@index([clubId, createdAt])
  /// «نظرة عامة»: الإيراد والمدفوع بيوم الدفع لكل نادٍ في فترة
  @@index([clubId, paidAt])
  @@map("orders")
}

/// سطر اللقطة: وحدة واحدة، بلا كمية. للإدراج فقط.
model OrderItem {
  id                  String               @id @default(uuid(7)) @db.Uuid
  orderId             String               @map("order_id") @db.Uuid
  position            Int                  @db.SmallInt
  kind                ProductKind
  productId           String               @map("product_id") @db.Uuid
  productVersionId    String               @map("product_version_id") @db.Uuid
  productSlug         String               @map("product_slug")
  nameAr              String               @map("name_ar")
  nameEn              String               @map("name_en")
  summaryAr           String               @map("summary_ar")
  summaryEn           String               @map("summary_en")
  /// [{"ar":..,"en":..}] بترتيب العرض
  benefits            Json
  durationMonths      Int?                 @map("duration_months")
  bonusMonths         Int                  @map("bonus_months")
  /// قاعدة البدء مختومة على سطر الاشتراك عند الإنشاء
  membershipStartRule MembershipStartRule? @map("membership_start_rule")
  currency            String               @db.Char(3)
  vatRateBps          Int                  @map("vat_rate_bps")
  listPriceMinor      Int                  @map("list_price_minor")
  discountMinor       Int                  @map("discount_minor")
  totalMinor          Int                  @map("total_minor")
  vatMinor            Int                  @map("vat_minor")

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// FK1: السعر والعملة والأشهر المجانية لا تخالف النسخة المباعة
  versionPrice    ProductVersion  @relation("OrderItemVersionPrice", fields: [productVersionId, productId, listPriceMinor, currency, bonusMonths], references: [id, productId, priceMinor, currency, bonusMonths], onDelete: Restrict, onUpdate: Restrict)
  /// FK2: مدة سطر الاشتراك لا تخالف النسخة (MATCH SIMPLE: لا يُفحص إن كانت المدة فارغة)
  versionDuration ProductVersion? @relation("OrderItemVersionDuration", fields: [productVersionId, durationMonths], references: [id, durationMonths], onDelete: Restrict, onUpdate: Restrict)
  /// FK3: نوع السطر هو نوع المنتج
  product         Product         @relation("OrderItemProductKind", fields: [productId, kind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  /// واحد على الأكثر فعليًا: UNIQUE(memberships.order_item_id)
  memberships     Membership[]

  @@unique([orderId, position])
  @@unique([orderId, productId])
  /// هدف FK5: الاشتراك لسطر اشتراك من الطلب نفسه
  @@unique([id, orderId, kind])
  @@map("order_items")
}

/// الخصم المطبَّق، وهو نفسه سجل استخدام العرض. «نشط» ما دام طلبه ليس expired ولا cancelled.
model OrderDiscount {
  id               String         @id @default(uuid(7)) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  promotionId      String         @map("promotion_id") @db.Uuid
  source           DiscountSource
  code             String?
  nameAr           String         @map("name_ar")
  nameEn           String         @map("name_en")
  discountKind     DiscountKind   @map("discount_kind")
  percentBps       Int?           @map("percent_bps")
  fixedAmountMinor Int?           @map("fixed_amount_minor")
  sequence         Int            @db.SmallInt
  amountMinor      Int            @map("amount_minor")
  createdAt        DateTime       @map("created_at") @db.Timestamptz(3)

  /// FK4: عميل الاستخدام هو عميل الطلب
  order     Order     @relation(fields: [orderId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([orderId, source])
  @@unique([orderId, sequence])
  @@unique([orderId, promotionId])
  @@index([promotionId, customerId])
  @@map("order_discounts")
}

/// الاشتراك: لا يوجد إلا لطلب مدفوع، ومرة واحدة لكل طلب. ends_on حدّ غير مشمول.
model Membership {
  id          String              @id @default(uuid(7)) @db.Uuid
  clubId      String              @map("club_id") @db.Uuid
  customerId  String              @map("customer_id") @db.Uuid
  orderId     String              @unique @map("order_id") @db.Uuid
  orderItemId String              @unique @map("order_item_id") @db.Uuid
  orderPaidAt DateTime            @map("order_paid_at") @db.Timestamptz(3)
  itemKind    ProductKind         @default(membership) @map("item_kind")
  paidMonths  Int                 @map("paid_months")
  bonusMonths Int                 @map("bonus_months")
  startRule   MembershipStartRule @map("start_rule")
  status      MembershipStatus
  startsOn    DateTime?           @map("starts_on") @db.Date
  endsOn      DateTime?           @map("ends_on") @db.Date
  cancelledAt DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  club      Club      @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// FK5: سطر اشتراك من الطلب نفسه
  orderItem OrderItem @relation(fields: [orderItemId, orderId, itemKind], references: [id, orderId, kind], onDelete: Restrict, onUpdate: Restrict)
  /// FK6: لا اشتراك إلا لطلب مدفوع
  paidOrder Order     @relation(fields: [orderId, orderPaidAt], references: [id, paidAt], onDelete: Restrict, onUpdate: Restrict)

  @@index([customerId, status])
  @@index([status, endsOn])
  @@map("memberships")
}

/// نموذج بيانات فقط: لا كاتب له في المرحلة 3 (أهلية الاسترداد غير محسومة).
model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  clubId           String       @map("club_id") @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  amountMinor      Int          @map("amount_minor")
  status           RefundStatus @default(requested)
  reason           String
  provider         String?
  providerRefundId String?      @map("provider_refund_id")
  requestedAt      DateTime     @map("requested_at") @db.Timestamptz(3)
  decidedAt        DateTime?    @map("decided_at") @db.Timestamptz(3)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)

  club  Club  @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerRefundId])
  @@index([orderId])
  @@map("refunds")
}

/// طلب تقييم (ليد) لخدمة بتقييم، لا طلب شراء. لا بيانات صحية هنا.
model AssessmentRequest {
  id                 String      @id @default(uuid(7)) @db.Uuid
  clubId             String      @map("club_id") @db.Uuid
  customerId         String      @map("customer_id") @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  productKind        ProductKind @default(assessed_service) @map("product_kind")
  customerName       String      @map("customer_name")
  customerPhoneE164  String      @map("customer_phone_e164")
  locale             String      @db.Char(2)
  idempotencyKey     String      @unique @map("idempotency_key") @db.Uuid
  requestFingerprint String      @map("request_fingerprint") @db.Char(64)
  createdAt          DateTime    @map("created_at") @db.Timestamptz(3)

  club     Club     @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// FK7: المنتج خدمة بتقييم فقط
  product  Product  @relation(fields: [productId, productKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)

  @@index([customerId, createdAt])
  @@map("assessment_requests")
}

/// سجل تدقيق للإلحاق فقط. data بلا جوال ولا اسم.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  clubId     String   @map("club_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  fromState  String?  @map("from_state")
  toState    String?  @map("to_state")
  actor      String
  data       Json     @default("{}")
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([clubId, createdAt])
  @@map("audit_logs")
}

/// حالات محاولة الدفع. جدول الانتقالات في packages/domain، والقاعدة تفرض الثوابت الخشنة (T8).
enum PaymentAttemptStatus {
  created
  pending
  authorized
  captured
  failed
  voided
  expired
  refunded

  @@map("payment_attempt_status")
}

/// محاولة دفع لطلب عند مزوّد (المرحلة 4أ). المبلغ والعملة لقطة من الطلب، والطلب لا يُنهى ما دامت
/// له محاولة حيّة: created أو pending أو authorized، أو captured ولم تُسجَّل تسويتها (T8 و T9).
model PaymentAttempt {
  id                String               @id @default(uuid(7)) @db.Uuid
  clubId            String               @map("club_id") @db.Uuid
  orderId           String               @map("order_id") @db.Uuid
  provider          String
  /// وسيلة الدفع كما يسميها المزوّد (رمز آلي)
  method            String?
  status            PaymentAttemptStatus @default(created)
  amountMinor       Int                  @map("amount_minor")
  currency          String               @db.Char(3)
  /// معرّف جلسة المزوّد (فاتورة Moyasar مثلًا). يُكتب مرة
  providerSessionId String?              @map("provider_session_id")
  /// معرّف الدفعة الذي يُمرَّر إلى markOrderPaid. يُكتب مرة
  providerPaymentId String?              @map("provider_payment_id")
  /// آخر حالة خام قُرئت من المزوّد
  providerStatus    String?              @map("provider_status")
  providerMode      String               @map("provider_mode")
  /// لا يُكمل العميل الدفع بعده: expires_at ناقص الهامش (الشرط الصلب 1)
  deadlineAt        DateTime             @map("deadline_at") @db.Timestamptz(3)
  /// مطالبة مزامنة واحدة في كل لحظة
  syncLeaseUntil    DateTime?            @map("sync_lease_until") @db.Timestamptz(3)
  /// عادت markOrderPaid بنتيجة (نجاح أو رفض). تُكتب مرة مع settlement_result
  settledAt         DateTime?            @map("settled_at") @db.Timestamptz(3)
  /// paid أو replayed أو سبب DomainError
  settlementResult  String?              @map("settlement_result")
  /// رمز آلي، لا نص من المزوّد
  failureReason     String?              @map("failure_reason")
  lastCheckedAt     DateTime?            @map("last_checked_at") @db.Timestamptz(3)
  checkCount        Int                  @default(0) @map("check_count")
  createdAt         DateTime             @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @map("updated_at") @db.Timestamptz(3)
  pendingAt         DateTime?            @map("pending_at") @db.Timestamptz(3)
  authorizedAt      DateTime?            @map("authorized_at") @db.Timestamptz(3)
  capturedAt        DateTime?            @map("captured_at") @db.Timestamptz(3)
  endedAt           DateTime?            @map("ended_at") @db.Timestamptz(3)

  club      Club              @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  incidents PaymentIncident[]

  @@unique([provider, providerSessionId])
  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status, deadlineAt])
  @@map("payment_attempts")
}

/// حادثة دفع تنبّه الإدارة (الشرط الصلب 4): إلحاق فقط، وأعمدة الحسم تُكتب مرة (T10).
/// data بلا اسم ولا جوال. لا تفعيل ولا استرداد آلي بها.
model PaymentIncident {
  id         String    @id @default(uuid(7)) @db.Uuid
  clubId     String    @map("club_id") @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  attemptId  String?   @map("attempt_id") @db.Uuid
  kind       String
  data       Json
  openedAt   DateTime  @map("opened_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolution String?
  resolvedBy String?   @map("resolved_by")

  club    Club            @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// حادثة واحدة من كل نوع لكل محاولة
  @@unique([attemptId, kind])
  @@index([orderId])
  @@map("payment_incidents")
}

/// أدوار موظفي لوحة التحكم. خريطة الصلاحيات في packages/domain/src/staff/permissions.ts.
enum StaffRole {
  owner
  manager
  editor
  sales

  @@map("staff_role")
}

enum StaffStatus {
  active
  disabled

  @@map("staff_status")
}

/// موظف لوحة التحكم (ADMIN_DESIGN §4.2). لا يُحذف: سجل التدقيق يشير إليه. المحفّز S1 يبقي مالكًا
/// نشطًا واحدًا على الأقل لكل نادٍ.
model StaffUser {
  id                 String      @id @default(uuid(7)) @db.Uuid
  clubId             String      @map("club_id") @db.Uuid
  /// صغير الحروف دائمًا (قيد)، ففرادته بلا حساسية حروف.
  email              String      @unique
  displayName        String      @map("display_name")
  role               StaffRole
  status             StaffStatus @default(active)
  /// scrypt بصيغة تحمل المعاملات (packages/db/src/staff/crypto/password-hash.ts).
  passwordHash       String      @map("password_hash")
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  /// سر TOTP مشفّرًا AES-256-GCM بـADMIN_SECRET_KEY. قبل التأكيد: سر معلّق و totp_enabled_at فارغ.
  totpSecretEnc      String?     @map("totp_secret_enc")
  totpEnabledAt      DateTime?   @map("totp_enabled_at") @db.Timestamptz(3)
  /// آخر خطوة زمنية قُبل رمزها: رمزها وما قبلها لا يُقبل ثانية.
  totpLastStep       BigInt?     @map("totp_last_step")
  failedLogins       Int         @default(0) @map("failed_logins")
  lockedUntil        DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?   @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  club            Club                    @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions        StaffSession[]
  recoveryCodes   StaffRecoveryCode[]
  manualPayments  ManualPayment[]
  contentReleases ContentRelease[]
  contentDrafts   ContentDraftEntry[]
  mediaAssets     MediaAsset[]
  slidesCreated   ContentSlide[]          @relation("SlideCreatedBy")
  slidesUpdated   ContentSlide[]          @relation("SlideUpdatedBy")
  sliderSettings  ContentSliderSettings[]

  @@index([clubId, role, status])
  @@map("staff_users")
}

/// جلسة موظف. الرمز نفسه في الكوكي فقط؛ هنا تجزئته SHA-256.
model StaffSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  staffUserId   String    @map("staff_user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(3)
  /// الحد المطلق من لحظة الدخول؛ لا يتمدد.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  ip            String
  userAgent     String    @map("user_agent")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffUserId, revokedAt])
  @@map("staff_sessions")
}

/// رمز استرجاع للخطوة الثانية: مجزأ، ويُستعمل مرة واحدة.
model StaffRecoveryCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  codeHash    String    @unique @map("code_hash")
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffUserId])
  @@map("staff_recovery_codes")
}

/// دفعة يدوية سجّلها موظف من اللوحة (حوالة بنكية أو مدفوع في النادي). إلحاق فقط (T12)، ومعرّفها هو
/// `orders.paid_provider_payment_id` للطلب الذي سوّته (T13). ADMIN_A2_SALES §6.5.
model ManualPayment {
  /// يولَّد عند رسم نموذج التأكيد: مفتاح عدم التكرار
  id                String   @id @db.Uuid
  clubId            String   @map("club_id") @db.Uuid
  orderId           String   @unique @map("order_id") @db.Uuid
  /// bank_transfer أو paid_at_club (CHECK)
  method            String
  /// مرجع الحوالة أو رقم سند القبض كما كتبه الموظف (للعرض)
  externalReference String   @map("external_reference")
  /// مفتاح الفرادة الموحَّد (manualReferenceKey): حروف وأرقام فقط
  referenceKey      String   @map("reference_key")
  /// يوم الاستلام بتقويم النادي
  receivedOn        DateTime @map("received_on") @db.Date
  amountMinor       Int      @map("amount_minor")
  currency          String   @db.Char(3)
  /// نص حر قد يحوي بيانًا شخصيًا: لا يُنسخ إلى التدقيق ولا السجلات
  note              String?
  recordedBy        String   @map("recorded_by") @db.Uuid
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  club  Club      @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staff StaffUser @relation(fields: [recordedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// المرجع الخارجي لا يسوّي طلبين في النادي، بأي طريقة وبأي كتابة
  @@unique([clubId, referenceKey])
  @@map("manual_payments")
}

/// إصدار محتوى منشور (ADMIN_A3_CONTENT §8): لقطة كاملة لتجاوزات النصوص لا تتغير بعد إدراجها (C1).
/// الموقع العام يقرأ آخر إصدار لنادي المحتوى بفهرس (club_id, seq).
model ContentRelease {
  id             String   @id @db.Uuid
  clubId         String   @map("club_id") @db.Uuid
  /// رقم الإصدار في النادي: max + 1 تحت القفل الاستشاري، والفرادة سدّه الاحتياطي
  seq            Int
  /// التجاوزات وحدها لا القاموس: { v: 1, texts: { مسار: { لغة: { value, baseHash } } } }
  snapshot       Json
  schemaVersion  Int      @map("schema_version") @db.SmallInt
  /// SHA-256 للشكل القانوني للتجاوزات: المسودة «متغيرة» حين تختلف بصمتها عن آخر إصدار
  digest         String   @db.Char(64)
  /// publish أو rollback (CHECK)
  source         String
  /// عدد التغييرات عن الإصدار السابق، يُحسب مرة عند الإدراج للسجل
  changedCount   Int      @map("changed_count")
  rolledBackFrom String?  @map("rolled_back_from") @db.Uuid
  publishedBy    String   @map("published_by") @db.Uuid
  publishedAt    DateTime @map("published_at") @db.Timestamptz(3)

  club       Club                  @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rolledBack ContentRelease?       @relation("ContentRollback", fields: [rolledBackFrom], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rollbacks  ContentRelease[]      @relation("ContentRollback")
  staff      StaffUser             @relation(fields: [publishedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media      ContentReleaseMedia[]

  @@unique([clubId, seq])
  @@map("content_releases")
}

/// مسودة المحتوى (ADMIN_A3_CONTENT §8.2): مجموعة التجاوزات الكاملة المرغوبة لكل نادٍ، صف لكل مفتاح ولغة.
/// value = { value, baseHash } لتجاوز، أو NULL «عودة إلى الافتراضي». نسخة عمل لا سجل: النشر يلتقطها.
model ContentDraftEntry {
  clubId    String   @map("club_id") @db.Uuid
  /// text:<مسار> (CHECK)
  entryKey  String   @map("entry_key")
  /// ar أو en (CHECK)
  locale    String
  value     Json?
  updatedBy String   @map("updated_by") @db.Uuid
  /// رمز القفل المتفائل: يُرفع بتسلسل صارم مع كل كتابة
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  club  Club      @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staff StaffUser @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([clubId, entryKey, locale])
  @@map("content_draft_entries")
}

/// مكتبة الوسائط (ADMIN_A3_SLIDER §6): صورة مرفوعة بعد إعادة ترميزها إلى AVIF وWebP بعدة عروض على مجلد
/// MEDIA_DIR باسم بصمة البايتات الواردة. الأصل لا يتغير بعد إنشائه (C2)، ويُحذف ما لا يستعمله شيء فقط.
model MediaAsset {
  id            String   @id @db.Uuid
  clubId        String   @map("club_id") @db.Uuid
  /// SHA-256 للبايتات الواردة: اسم مجلد النسخ ورابطها، وفريد في النادي (صورة مكررة ترجع القائمة)
  sha256        String   @db.Char(64)
  width         Int
  height        Int
  bytes         Int
  /// عروض النسخ تصاعديًا؛ لكل عرض ملفا w<عرض>.avif وw<عرض>.webp
  variantWidths Int[]    @map("variant_widths")
  blurDataUrl   String   @map("blur_data_url")
  dominantColor String   @map("dominant_color") @db.Char(7)
  originalName  String   @map("original_name")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)

  club          Club                  @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staff         StaffUser             @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  desktopSlides ContentSlide[]        @relation("SlideDesktopImage")
  mobileSlides  ContentSlide[]        @relation("SlideMobileImage")
  releases      ContentReleaseMedia[]

  @@unique([clubId, sha256])
  @@map("media_assets")
}

/// شرائح الشريط في المسودة (ADMIN_A3_SLIDER §2): نسخة عمل يلتقطها النشر في لقطة الإصدار. الصورتان
/// بـFK RESTRICT، فصورة تستعملها شريحة لا تُحذف.
model ContentSlide {
  id             String    @id @db.Uuid
  clubId         String    @map("club_id") @db.Uuid
  /// ترتيب كثيف 0..n-1 يُعاد كتابته كله تحت قفل المحتوى
  position       Int
  desktopAssetId String    @map("desktop_asset_id") @db.Uuid
  mobileAssetId  String?   @map("mobile_asset_id") @db.Uuid
  decorative     Boolean
  altAr          String    @map("alt_ar")
  altEn          String    @map("alt_en")
  eyebrowAr      String    @map("eyebrow_ar")
  eyebrowEn      String    @map("eyebrow_en")
  titleAr        String    @map("title_ar")
  titleEn        String    @map("title_en")
  subtitleAr     String    @map("subtitle_ar")
  subtitleEn     String    @map("subtitle_en")
  ctaAr          String    @map("cta_ar")
  ctaEn          String    @map("cta_en")
  /// none أو internal أو external (CHECK)
  linkKind       String    @map("link_kind")
  /// المسار الداخلي أو رابط https الخارجي؛ فارغ بلا رابط
  linkTarget     String    @map("link_target")
  linkNewTab     Boolean   @map("link_new_tab")
  /// slide أو button (CHECK)
  clickTarget    String    @map("click_target")
  active         Boolean
  startsAt       DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(3)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  updatedBy      String    @map("updated_by") @db.Uuid
  /// رمز القفل المتفائل: يُرفع بتسلسل صارم مع كل كتابة
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  club    Club        @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  desktop MediaAsset  @relation("SlideDesktopImage", fields: [desktopAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mobile  MediaAsset? @relation("SlideMobileImage", fields: [mobileAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator StaffUser   @relation("SlideCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  editor  StaffUser   @relation("SlideUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([clubId, position])
  @@map("content_slides")
}

/// إعدادات الشريط في المسودة (ADMIN_A3_SLIDER §5): صف واحد للنادي، وغيابه = الافتراضي.
model ContentSliderSettings {
  clubId     String   @id @map("club_id") @db.Uuid
  autoplay   Boolean
  intervalMs Int      @map("interval_ms")
  updatedBy  String   @map("updated_by") @db.Uuid
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  club  Club      @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staff StaffUser @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("content_slider_settings")
}

/// الأصول التي دخلت إصدارًا (ADMIN_A3_SLIDER §6.3): للإلحاق فقط (C3) مع FK RESTRICT، فأصل نُشر مرة لا
/// يُحذف أبدًا، والاسترجاع إلى إصدار قديم يجد صوره. ويقرر هل يُخدَّم الملف للعامة.
model ContentReleaseMedia {
  releaseId String @map("release_id") @db.Uuid
  assetId   String @map("asset_id") @db.Uuid

  release ContentRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset   MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([releaseId, assetId])
  @@index([assetId])
  @@map("content_release_media")
}

/// إعداد منصة ربط وقياس لنادٍ (ADMIN_A5_TRACKING §7). المعرّفات العامة في `config`، والمفتاح الخادمي
/// مشفّرًا وحده (AES-256-GCM بمفتاح فرعي من ADMIN_SECRET_KEY)، ولا يُقرأ إلا عند الإرسال.
model TrackingIntegration {
  clubId        String   @map("club_id") @db.Uuid
  provider      String
  enabled       Boolean  @default(false)
  config        Json     @default("{}")
  secretEnc     String?  @map("secret_enc")
  secretLast4   String?  @map("secret_last4")
  testEventCode String?  @map("test_event_code")
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(3)
  updatedBy     String?  @map("updated_by") @db.Uuid

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([clubId, provider])
  @@map("tracking_integrations")
}

/// موافقة الزائر وإسناده ومعرّفات متصفحه لحظة إنشاء الطلب. للإدراج فقط: ما خُتم لا يتغير.
model OrderTracking {
  orderId          String    @id @map("order_id") @db.Uuid
  clubId           String    @map("club_id") @db.Uuid
  consentAnalytics Boolean   @map("consent_analytics")
  consentAds       Boolean   @map("consent_ads")
  consentVersion   Int?      @map("consent_version")
  consentAt        DateTime? @map("consent_at") @db.Timestamptz(3)
  firstTouch       Json?     @map("first_touch")
  lastTouch        Json?     @map("last_touch")
  gaClientId       String?   @map("ga_client_id")
  fbp              String?
  fbc              String?
  scid             String?
  ttp              String?
  clientIp         String?   @map("client_ip")
  userAgent        String?   @map("user_agent")
  pageUrl          String?   @map("page_url")
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  club  Club  @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("order_tracking")
}

/// طابور الإرسال الخادمي وسجله: سطر لكل حدث ومنصة. الحي فريد بمعرّف حدثه، والاختبار بلا طلب.
model TrackingOutbox {
  id            String    @id @default(uuid(7)) @db.Uuid
  clubId        String    @map("club_id") @db.Uuid
  orderId       String?   @map("order_id") @db.Uuid
  provider      String
  eventName     String    @map("event_name")
  eventId       String    @map("event_id")
  kind          String    @default("live")
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @map("next_attempt_at") @db.Timestamptz(3)
  lastStatus    Int?      @map("last_status")
  lastReason    String?   @map("last_reason")
  eventTime     DateTime  @map("event_time") @db.Timestamptz(3)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)
  /// رمز الحجز الحالي: النتيجة تُسجَّل بالرمز وحده، فمرسِل انقضت مهلته لا يكتب فوق غيره (القرار 89-2)
  claimToken    String?   @map("claim_token") @db.Uuid

  club  Club   @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt])
  @@index([clubId, createdAt])
  @@index([orderId])
  @@map("tracking_outbox")
}

/// أول عرض لصفحة الطلب المدفوع حمل الجوال المجزّأ إلى المتصفح: مرة واحدة لكل طلب (القرار 89-1).
model TrackingBrowserPurchase {
  orderId   String   @id @map("order_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("tracking_browser_purchases")
}
