# مثال لملف deploy/.env على الخادم. لا قيمة حقيقية هنا: الملف داخل git.
# الملف الحقيقي ينشئه bootstrap.sh في /opt/masar/deploy/.env (صلاحية 600)، وتُضاف إليه الأسطر يدويًا
# على الخادم وحده بالخطوات في docs/DEPLOYMENT.md وdocs/BACKUP.md. لا تُلصق قيمة منها في محادثة.

# يولّدها bootstrap.sh
DB_PASSWORD=
SITE_HOST=
SITE_URL=
SITE_INDEXABLE=false

# لوحة التحكم (docs/DEPLOYMENT.md «لوحة التحكم»)
ADMIN_SECRET_KEY=

# رفع الصور (docs/DEPLOYMENT.md «رفع صور الشرائح»)
MEDIA_UPLOADS=

# ---- النسخ الاحتياطي المشفر خارج الخادم (docs/BACKUP.md §7) ----
# الأسماء أسماء restic الرسمية بالحرف. المستودع على Backblaze B2 بواجهة S3:
#   s3:https://s3.<المنطقة>.backblazeb2.com/<اسم الحاوية>
# المنطقة من حقل Endpoint في صفحة الحاوية (مثل us-west-004 أو eu-central-003).
RESTIC_REPOSITORY=
# كلمة مرور التشفير: تولَّد على الخادم (openssl rand -base64 33) وتُحفظ أيضًا خارجه في مدير كلمات
# مرور. ضياعها = ضياع كل النسخ، ولا يستطيع أحد استرجاعها.
RESTIC_PASSWORD=
# مفتاح تطبيق B2 مقيَّد بالحاوية وحدها: keyID ثم applicationKey
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# المنطقة نفسها التي في الرابط (us-west-004 مثلًا)
AWS_DEFAULT_REGION=
# اختياري: رابط نبضة بنمط healthchecks.io (https://...). يُطلب عند النجاح، و/fail عند الفشل
BACKUP_PING_URL=
# اختياري: نطاق فحص السلامة الأسبوعي (الافتراضي 20%)
BACKUP_CHECK_SUBSET=

# قديم: إعلان يدوي بوجود نسخة احتياطية. لا حاجة إليه بعد أول تجربة استرجاع ناجحة: السجل الآلي يحكم
BACKUP_CONFIGURED=
