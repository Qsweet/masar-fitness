{
  "name": "masar-fitness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typegen": "pnpm --filter @masar/web exec next typegen",
    "lint": "pnpm typegen && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "build": "pnpm --filter @masar/web build",
    "e2e": "pnpm --filter @masar/web e2e",
    "db:generate": "pnpm --filter @masar/db generate",
    "db:migrate": "pnpm --filter @masar/db migrate:deploy",
    "db:seed:demo": "pnpm --filter @masar/db seed:demo",
    "admin:create-owner": "pnpm --filter @masar/db admin:create-owner",
    "admin:reset-owner-mfa": "pnpm --filter @masar/db admin:reset-owner-mfa",
    "admin:reset-owner-password": "pnpm --filter @masar/db admin:reset-owner-password",
    "slider:launch-kit": "pnpm --filter @masar/web slider:launch-kit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "@types/node": "22.20.5",
    "vitest": "5.1.1"
  }
}
