[Unit]
Description=Daily Masar backup between 03:00 and 04:00 Riyadh time

[Timer]
# 00:00 UTC = 03:00 في الرياض، ثم إزاحة عشوائية ثابتة لهذا الخادم داخل الساعة
OnCalendar=*-*-* 00:00:00 UTC
RandomizedDelaySec=1h
FixedRandomDelay=true
# دورة فاتت والخادم مطفأ تعمل عند إقلاعه
Persistent=true

[Install]
WantedBy=timers.target
