# انسخ هذا الملف إلى apps/web/.env.local و packages/db/.env للتطوير المحلي.
# لا تضع أسرارًا حقيقية هنا: الملف داخل git.

# قاعدة التطوير (docker compose up -d db)
DATABASE_URL=postgresql://masar:masar@127.0.0.1:5432/masar_dev

# الرابط العام للموقع (https إلزامي في الإنتاج)
SITE_URL=http://localhost:3000

# الفهرسة مغلقة افتراضيًا. لا تُفتح ("true") إلا على النطاق الرسمي وبأمر المالك.
SITE_INDEXABLE=false

# الشراء الإلكتروني مغلق افتراضيًا ("true" حرفيًا فقط تفتحه). مرفوض في الإنتاج إلا على عنوان
# الجهاز نفسه (اختبار البناء الإنتاجي) حتى يوجد دفع حي.
CHECKOUT_ENABLED=

# يضبطه النشر آليًا
# APP_VERSION=

# الدفع الإلكتروني (المرحلة 4أ): كلها اختيارية. بلا PAYMENTS_MODE (أو off) لا مزوّد ولا زر دفع.
# القيم الحقيقية تُكتب على الخادم في deploy/.env فقط، لا هنا ولا في المحادثة (docs/PAYMENTS.md).
# off أو test. القيمة live مرفوضة في الكود حتى يأذن المالك إذنًا مستقلًا.
PAYMENTS_MODE=
# moyasar، أو fake (محاكاة محلية بلا مال، تعمل على عنوان الجهاز نفسه فقط)
PAYMENTS_PROVIDER=
# أقل وقت معقول لإكمال الدفع بالدقائق. بلا قيمة افتراضية: يُقاس في تجربة البيئة التجريبية (WP0).
PAYMENTS_MIN_PAYMENT_MINUTES=
# مفتاح Moyasar السري التجريبي (يبدأ بـsk_test_)
MOYASAR_SECRET_KEY=
# السر المكتوب في حقل Secret Token عند إنشاء رابط الإشعار في لوحة Moyasar (32 محرفًا على الأقل)
MOYASAR_WEBHOOK_SECRET=
# أصل صفحة الدفع المستضافة عند Moyasar (https://host بلا مسار) لسياسة CSP form-action. بلا افتراضي:
# يُقرأ من رابط فاتورة حقيقية في التجربة (WP0). بلا قيمة يبقى form-action 'self'.
MOYASAR_HOSTED_PAGE_ORIGIN=
# إذن صريح ("yes") لفتح الشراء على معاينة عامة بمفاتيح التجربة. ينتظر موافقة المالك (القرار 51).
PAYMENTS_PUBLIC_SANDBOX=
# إذن صريح ("yes") لمزوّد الاختبار على بناء إنتاجي محلي (اختبارات المتصفح). لا يُضبط على خادم.
PAYMENTS_ALLOW_FAKE=
# سر إشعار المحاكاة المحلية (مع PAYMENTS_PROVIDER=fake فقط)
PAYMENTS_FAKE_WEBHOOK_SECRET=
