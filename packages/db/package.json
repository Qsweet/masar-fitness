{
  "name": "@masar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-support": "./src/test-support/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "orders:expire": "tsx prisma/expire-orders.ts",
    "admin:create-owner": "tsx scripts/admin/create-owner.ts",
    "admin:reset-owner-mfa": "tsx scripts/admin/reset-owner-mfa.ts",
    "admin:reset-owner-password": "tsx scripts/admin/reset-owner-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@masar/domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
